{
  "manifest_version": 3,
  "name": "Walmart Personal Purchase Exporter",
  "version": "1.1.0",
  "description": "Export your own Walmart purchase history into local CSV or JSON files. No accounts, payments or external servers.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "Walmart Personal Purchase Exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.walmart.com/orders*", "https://www.walmart.com/orders/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
